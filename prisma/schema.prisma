generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum AccessLevel {
  REGULAR
  VIP
  VIP_PLUS
}

enum SubscriptionStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentProvider {
  MTN_MOMO
  ORANGE_MONEY
}

enum CreatorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum UserRole {
  CREATOR
  ADMIN
}
enum MediaKind {
  IMAGE
  VIDEO
}

enum PostType {
  GALLERY
  FEED
}
//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model user {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(CREATOR)

  creatorprofile creatorprofile?
  postlikes      postlike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// CREATOR PROFILE
//////////////////////////////////////////////////////

model creatorprofile {
  id          Int     @id @default(autoincrement())
  displayName String
  bio         String?
  avatarUrl   String?
  location    String?

  userId Int  @unique
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier   AccessLevel  @default(REGULAR)
  status CreatorStatus @default(PENDING)

  subscriptionEndsAt DateTime?

  whatsappNumber String?

  // Analytics
  profileViewsToday   Int @default(0)
  whatsappClicksToday Int @default(0)
  profileViewsWeek    Int @default(0)
  whatsappClicksWeek  Int @default(0)
  profileViewsMonth   Int @default(0)
  whatsappClicksMonth Int @default(0)

  // VIP+ advanced analytics
  bestDay            String?
  bestTime           String?
  whatsappCTR        Float?
  externalLinksCount Int?

  post          post[]
  media         media[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([location])
  @@index([tier])
  
}

//////////////////////////////////////////////////////
// POSTS
//////////////////////////////////////////////////////

model post {
  id        Int      @id @default(autoincrement())
  creatorId Int
  title     String
  content   String?

  accessLevel AccessLevel @default(REGULAR)
  blurred  Boolean  @default(false)
  postType PostType @default(FEED)

  creatorprofile creatorprofile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  likes postlike[]
  media media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// MEDIA
//////////////////////////////////////////////////////

model media {
  id        Int      @id @default(autoincrement())
  creatorId Int
  postId    Int?

  kind      MediaKind   // "image" | "video"
  filePath  String
  mimeType  String
  sizeBytes Int

  creatorprofile creatorprofile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  post           post?          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([postId])
}

//////////////////////////////////////////////////////
// POST LIKE
//////////////////////////////////////////////////////

model postlike {
  postId Int
  userId Int

  post post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// SUBSCRIPTION
//////////////////////////////////////////////////////

model Subscription {
  id               Int            @id @default(autoincrement())
  creatorProfileId Int
  creatorProfile   creatorprofile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  plan         AccessLevel
  durationDays Int                // 7, 14, 30
  provider     PaymentProvider
  status       SubscriptionStatus @default(PENDING)

  amountCfa Int
  startsAt  DateTime
  endsAt    DateTime

  phoneNumber   String?
  screenshotUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorProfileId])
  @@index([status])
  @@index([endsAt])
}